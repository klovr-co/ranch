#!/usr/bin/env bash
# setup — make this machine ready to work. Safe to re-run: it only changes what's different.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
. "$ROOT/lib/os.sh"
. "$ROOT/lib/tools.sh"
. "$ROOT/lib/teams.sh"
. "$ROOT/lib/login.sh"

usage() {
  cat <<'EOF'
setup — make this machine ready to work

  setup                       Install or update everything (re-uses teams added before)
  setup --team owner/repo     Add a team config, then install or update
  setup login                 Sign in to anything missing (GitHub, Claude, Codex, …)
  setup login status          Only show what's signed in
  setup doctor                Show what's installed

Safe to re-run any time.
EOF
}

doctor() {
  detect_os
  step "Machine: $OS_NAME ($(uname -m))"
  local t
  for t in mise git gh node pnpm claude codex tmux tailscale; do
    if has "$t"; then ok "$t"; else warn "$t missing"; fi
  done
  step "Teams"
  if [ -s "$TEAMS_LIST" ]; then
    while IFS= read -r t; do info "$t"; done < "$TEAMS_LIST"
  else
    info "none (add one with: setup --team owner/repo)"
  fi
}

main() {
  local teams=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help|help) usage; exit 0 ;;
      doctor) doctor; exit 0 ;;
      login)
        detect_os
        if [ "${2:-}" = status ]; then run_logins status; else run_logins run; fi
        exit 0 ;;
      --team) [ $# -ge 2 ] || die "--team needs owner/repo"; teams="$teams $2"; shift 2 ;;
      --team=*) teams="$teams ${1#--team=}"; shift ;;
      *) die "Unknown argument: $1 (try --help)" ;;
    esac
  done

  detect_os
  install_base_packages
  install_mise
  install_base_tools
  install_agent_clis

  local t
  for t in $teams; do remember_team "$t"; done
  if [ -s "$TEAMS_LIST" ]; then
    while IFS= read -r t; do [ -n "$t" ] && apply_team "$t"; done < "$TEAMS_LIST"
  fi

  run_logins run

  step "Done"
  info "Open a new terminal so your shell picks up the changes."
}

main "$@"
