#!/usr/bin/env bash
# ranch — add this machine to your ranch: same tools, agent rules and logins as every other machine.
# Safe to re-run: it only changes what's different.
set -euo pipefail

# Resolve symlinks (~/.local/bin/ranch → checkout) without readlink -f, which older macOS lacks.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
unset src dir

# Non-interactive shells (e.g. over SSH) don't load the user's profile; find our tools anyway.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
. "$ROOT/lib/os.sh"
. "$ROOT/lib/tools.sh"
. "$ROOT/lib/teams.sh"
. "$ROOT/lib/network.sh"
. "$ROOT/lib/login.sh"
. "$ROOT/lib/remote.sh"
. "$ROOT/lib/t3.sh"
. "$ROOT/lib/secrets.sh"

usage() {
  cat <<'EOF'
ranch — add this machine to your ranch

  ranch                       Install or update everything (re-uses teams added before)
  ranch --team owner/repo     Add a team config, then install or update
  ranch login                 Sign in to anything missing (GitHub, Tailscale, Claude, Codex)
  ranch login status          Only show what's signed in
  ranch doctor                Show what's installed
  ranch status                This machine, your network, and every server you've added
  ranch update                Update every server you've added to the newest ranch

  ranch run -- <command>      Run a command with this project's secrets from Infisical (no .env files)
  ranch secrets connect [user@]machine
                              From your main computer: give a server its own Infisical login

  ranch join                  At a new Linux server: join your network (scan a QR code), nothing else
  ranch add [user@]machine    From your main computer: set that server up remotely, logins carried over
  ranch pair [user@]machine   From your main computer: a fresh link to pair that server with your T3 app

Safe to re-run any time.
EOF
}

# The installed copy keeps itself current; a dev checkout is left alone.
self_update() {
  [ "$ROOT" = "$HOME/.local/share/ranch" ] && [ -d "$ROOT/.git" ] || return 0
  [ -z "${RANCH_UPDATED:-}" ] || return 0
  local before after
  before="$(git -C "$ROOT" rev-parse HEAD)"
  git -C "$ROOT" pull --ff-only --quiet 2>/dev/null || { warn "Couldn't update ranch; using the current version"; return 0; }
  after="$(git -C "$ROOT" rev-parse HEAD)"
  if [ "$before" != "$after" ]; then
    info "ranch updated; restarting"
    RANCH_UPDATED=1 exec bash "$ROOT/bin/ranch" "$@"
  fi
}

# A snapshot install (made before git existed) becomes a clone once git is installed,
# so self_update can keep it current.
adopt_git() {
  [ "$ROOT" = "$HOME/.local/share/ranch" ] && [ ! -d "$ROOT/.git" ] && has git || return 0
  git -C "$ROOT" init -q
  git -C "$ROOT" remote add origin "${RANCH_REPO:-https://github.com/xian-jun/ranch.git}"
  git -C "$ROOT" fetch -q origin main && git -C "$ROOT" reset -q --hard origin/main \
    && git -C "$ROOT" branch -q -u origin/main 2>/dev/null || true
}

# Put `ranch` on PATH so it can be run from anywhere.
link_command() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$ROOT/bin/ranch" "$HOME/.local/bin/ranch"
}

doctor() {
  detect_os
  step "Machine: $OS_NAME ($(uname -m))"
  local t
  for t in mise git gh node pnpm claude codex tmux; do
    if has "$t"; then ok "$t"; else warn "$t missing"; fi
  done
  if [ -n "$(ts_bin)" ]; then ok "tailscale"; else warn "tailscale missing"; fi
  if [ "$OS" != macos ]; then if has t3; then ok "t3"; else warn "t3 missing"; fi; fi
  step "Teams"
  if [ -s "$TEAMS_LIST" ]; then
    while IFS= read -r t; do info "$t"; done < "$TEAMS_LIST"
  else
    info "none (add one with: ranch --team owner/repo)"
  fi
}

main() {
  self_update "$@"
  local teams="" logins=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help|help) usage; exit 0 ;;
      doctor) doctor; exit 0 ;;
      status) detect_os; show_status; exit 0 ;;
      update) detect_os; update_all; exit 0 ;;
      run) shift; secrets_run "$@" ;;
      secrets)
        case "${2:-}" in
          connect) connect_secrets "${3:-}"; exit 0 ;;
          check) secrets_check; exit $? ;;
          *) die "Usage: ranch secrets connect [user@]machine" ;;
        esac ;;
      join) detect_os; join_network; exit 0 ;;
      add) add_machine "${2:-}"; exit 0 ;;
      pair) [ -n "${2:-}" ] || die "Usage: ranch pair [user@]machine"
            RANCH_TARGET="$2"; case "$2" in *@*) ;; *) RANCH_TARGET="$(id -un)@$2" ;; esac
            pair_t3; exit 0 ;;
      --no-login) logins=0; shift ;;
      login)
        detect_os
        if [ "${2:-}" = status ]; then run_logins status; else run_logins run; fi
        exit 0 ;;
      --team) [ $# -ge 2 ] || die "--team needs owner/repo"; teams="$teams $2"; shift 2 ;;
      --team=*) teams="$teams ${1#--team=}"; shift ;;
      *) die "Unknown argument: $1 (try --help)" ;;
    esac
  done

  detect_os
  install_base_packages
  adopt_git
  install_mise
  install_base_tools
  install_agent_clis
  install_tailscale
  install_t3
  link_command

  local t
  for t in $teams; do remember_team "$t"; done
  if [ -s "$TEAMS_LIST" ]; then
    while IFS= read -r t; do [ -n "$t" ] && apply_team "$t"; done < "$TEAMS_LIST"
  fi

  if [ "$logins" = 1 ]; then run_logins run; fi

  step "Done"
  info "This machine is on the ranch. Open a new terminal, then run 'ranch doctor' any time."
}

main "$@"
